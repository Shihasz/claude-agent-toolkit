# Required: your Anthropic API key. Never commit the real value.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by the agent. Override for cost/latency tuning.
AGENT_MODEL=claude-sonnet-5

# Max tool-use turns before the agent is forced to stop (loop guard).
AGENT_MAX_TURNS=8

# Request timeout (seconds) for each call to the Anthropic API.
AGENT_REQUEST_TIMEOUT=60

# Max output tokens per model response.
AGENT_MAX_TOKENS=2048

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Simple per-process rate limit for the API server (requests/minute/IP)
API_RATE_LIMIT_PER_MINUTE=30
